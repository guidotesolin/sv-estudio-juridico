---
interface Props {
  variant?: "primary" | "ghost" | "beige";
  href?: string;
  type?: "button" | "submit";
  // Hook for scripts, e.g. the quote stepper's Atrás buttons.
  "data-back"?: boolean;
}

const { variant = "primary", href, type = "button", ...attrs } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  {...attrs}
  href={href}
  type={href ? undefined : type}
  class:list={["button", `button--${variant}`]}
>
  <slot />
</Tag>

<style>
  .button {
    display: inline-block;
    padding: 12px 20px;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      box-shadow var(--transition),
      transform 160ms var(--ease-out);
  }

  .button--primary {
    background: var(--color-primary);
    color: #fff;
  }

  .button--ghost {
    background: var(--color-card);
    border-color: var(--color-border);
    color: var(--color-primary);
  }

  .button--beige {
    background: var(--color-beige);
    color: var(--color-dark);
  }

  /* Touch fakes a sticky :hover on tap; only real pointers get it. */
  @media (hover: hover) and (pointer: fine) {
    .button:hover {
      box-shadow: var(--shadow-hover);
    }

    .button--primary:hover {
      background: var(--color-primary-hover);
    }

    .button--ghost:hover {
      background: var(--color-selected);
      border-color: var(--color-primary);
    }

    .button--beige:hover {
      background: var(--color-beige-hover);
    }
  }

  /* Press feedback for every input; dropped with reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .button:active {
      transform: scale(0.97);
    }
  }
</style>
