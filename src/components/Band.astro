---
interface Props {
  variant: "dark" | "beige";
  id?: string;
}

const { variant, id } = Astro.props;
---

<section id={id} class:list={["band", `band--${variant}`]}>
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .band {
    padding-block: var(--section-gap);
  }

  /* Full-bleed, fading in and out of the canvas instead of a hard edge, so the home can alternate
     canvas and beige sections without seams (T9). */
  .band--beige {
    --fade: clamp(64px, 10vw, 120px);

    background: linear-gradient(
      to bottom,
      var(--color-canvas),
      var(--color-beige) var(--fade),
      var(--color-beige) calc(100% - var(--fade)),
      var(--color-canvas)
    );
  }

  /* Inset closing banner, as on the live cord.com (docs/design/cord-style-reference.md). */
  .band--dark {
    width: min(100% - 2 * var(--gutter), var(--max-width) - 2 * var(--gutter));
    margin: var(--section-gap) auto 0;
    padding-block: clamp(40px, 6vw, 60px);
    border-radius: clamp(32px, 6vw, 80px);
    background: linear-gradient(78deg, var(--color-primary), var(--color-dark));
    color: var(--color-canvas);
  }

  .band--dark > .container {
    padding-inline: clamp(var(--gutter), 6vw, 60px);
    text-align: center;
  }

  /* The dark band is a closing call to action: centered heading, lead line and button. */
  .band--dark :global(h2),
  .band--dark :global(p) {
    max-width: 720px;
    margin-inline: auto;
  }

  .band--dark :global(h2) {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
  }

  .band--dark :global(p) {
    margin-block: 16px 28px;
    font-size: 18px;
    color: var(--color-border);
  }

  .band--dark :global(:focus-visible) {
    outline-color: var(--color-beige);
  }
</style>
