---
import { getCollection } from "astro:content";
import Band from "../components/Band.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { calUrl } from "../lib/booking";

const areas = (await getCollection("services")).toSorted(
  (a, b) => a.data.order - b.data.order,
);

const steps = [
  "Contanos tu situación",
  "Recibí un rango",
  "Elegí día y hora",
  "Definí cómo avanzar",
];
---

<BaseLayout description="Asesoramiento jurídico en sucesiones, laboral, daños y civil y comercial en Santa Fe. Cotizá tu caso y reservá una consulta online.">
  <section class="container hero">
    <p class="label">Asesoramiento · Estrategia · Gestión</p>
    <h1>Soluciones jurídicas claras.</h1>
    <p class="hero-subtitle">
      Te asesoramos, definimos la estrategia y gestionamos tu caso, con precios
      a la vista.
    </p>
    <div class="hero-actions">
      <Button href="/cotizar">Cotizar mi caso</Button>
      <Button variant="ghost" href={calUrl("consulta-inicial")}>
        Reservar una consulta
      </Button>
      <Button variant="ghost" href="/expediente">
        Ya tengo un expediente
      </Button>
    </div>
  </section>

  <Band variant="beige" id="servicios">
    <div class="section-head">
      <h2>Servicios</h2>
      <p>
        Elegí el área de tu consulta y mirá qué resolvemos, qué incluye y cómo
        se cobra.
      </p>
    </div>
    <ul class="grid areas">
      {areas.map((area) => (
        <li>
          <a class="area-link" href={`/servicios/${area.id}`}>
            <Card>
              <span class="icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {area.data.card.icon.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
              <h3>
                {area.data.card.title}{" "}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </h3>
              <p>{area.data.card.summary}</p>
            </Card>
          </a>
        </li>
      ))}
    </ul>
  </Band>

  <section id="como-trabajamos" class="container section">
    <div class="section-head">
      <h2>Cómo trabajamos</h2>
      <p>De tu primera consulta a un plan concreto, en cuatro pasos.</p>
    </div>
    <ol class="grid steps">
      {steps.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  </section>

  <Band variant="dark">
    <h2>¿Ya tenés un expediente en curso?</h2>
    <p>
      Podemos ayudarte a comprender el estado de tu proceso, revisar
      documentación y evaluar los pasos que podrían corresponder.
    </p>
    <Button variant="beige" href="/expediente">
      Pedir revisión <span aria-hidden="true">→</span>
    </Button>
  </Band>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(64px, 14vw, 180px);
    text-align: center;
    animation: fade-in 400ms var(--ease-out) both;
  }

  .hero h1 {
    margin: 16px 0 20px;
    /* cord sets 100px; 72px comes from the former two-line headline (one line since T8). */
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
  }

  .hero-subtitle {
    max-width: 560px;
    margin: 0 auto 32px;
    font-size: 18px;
    color: var(--color-text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* Stacked on a phone, the three CTAs share one width instead of hugging their labels. */
  @media (max-width: 599px) {
    .hero-actions {
      flex-direction: column;
      align-items: center;
    }

    .hero-actions > :global(.button) {
      width: min(100%, 320px);
    }
  }

  .section-head {
    max-width: 720px;
    margin: 0 auto 40px;
    text-align: center;
  }

  h2 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
  }

  .section-head p {
    margin: 12px 0 0;
    font-size: 18px;
    color: var(--color-text-secondary);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .areas li {
    animation: fade-in 400ms var(--ease-out) both;
  }

  .areas li:nth-child(2) {
    animation-delay: 0.08s;
  }

  .areas li:nth-child(3) {
    animation-delay: 0.16s;
  }

  .areas li:nth-child(4) {
    animation-delay: 0.24s;
  }

  .area-link {
    display: block;
    height: 100%;
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }

  .area-link > :global(.card) {
    position: relative;
    isolation: isolate;
    height: 100%;
    padding: 24px;
    transition:
      border-color var(--transition),
      transform 160ms var(--ease-out);
  }

  /* Flood: hover (pointer) or press (touch) fills the card with the closing banner's gradient. Only
     opacity animates, so it stays on the GPU; the text colors follow with the hover transition. */
  .area-link > :global(.card)::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    /* inset -1px covers the border, so the radius grows by 1px to match the card's outer edge. */
    border-radius: calc(var(--radius-card) + 1px);
    background: linear-gradient(78deg, var(--color-primary), var(--color-dark));
    opacity: var(--flood, 0);
    transition: opacity 200ms var(--ease-out);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-option);
    background: var(--card-icon-bg, var(--color-selected));
    color: var(--card-icon-fg, var(--color-primary));
    transition:
      background-color var(--transition),
      color var(--transition);
  }

  .icon svg {
    width: 24px;
    height: 24px;
  }

  .area-link h3 {
    margin-top: 20px;
    font-size: 18px;
    color: var(--card-title, var(--color-text));
    transition: color var(--transition);
  }

  .arrow {
    display: inline-block;
    color: var(--card-arrow, var(--color-primary));
    transition:
      color var(--transition),
      transform 200ms var(--ease-out);
  }

  /* :active is the tap feedback (the tap highlight is off); :hover only for real pointers. Both set
     the same flooded palette, read by the card's children above. */
  .area-link:active {
    --flood: 1;
    --card-title: var(--color-canvas);
    --card-text: var(--color-border);
    --card-icon-bg: rgb(251 248 242 / 0.12);
    --card-icon-fg: var(--color-canvas);
    --card-arrow: var(--color-beige);
  }

  .area-link:active > :global(.card) {
    border-color: var(--color-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .area-link:hover {
      --flood: 1;
      --card-title: var(--color-canvas);
      --card-text: var(--color-border);
      --card-icon-bg: rgb(251 248 242 / 0.12);
      --card-icon-fg: var(--color-canvas);
      --card-arrow: var(--color-beige);
    }

    .area-link:hover > :global(.card) {
      border-color: var(--color-primary);
      box-shadow: var(--shadow-card), var(--shadow-hover);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .area-link:active > :global(.card) {
      transform: scale(0.98);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .area-link:hover .arrow {
      transform: translateX(4px);
    }
  }

  .area-link p {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--card-text, var(--color-text-secondary));
    transition: color var(--transition);
  }

  .steps li {
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    font-size: 18px;
    font-weight: 600;
  }

  .steps li::before {
    content: counter(list-item);
    display: block;
    margin-bottom: 12px;
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary);
  }
</style>
