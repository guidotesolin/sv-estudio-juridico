---
import Band from "../components/Band.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { calUrl } from "../lib/booking";

// Icon paths are Tabler Icons (MIT), inlined so no icon CDN is needed.
const areas = [
  {
    slug: "sucesiones",
    title: "Sucesiones",
    summary: "Herencias y declaratoria",
    icon: [
      "M21 12l-9 -9l-9 9h2v7a2 2 0 0 0 2 2h6",
      "M9 21v-6a2 2 0 0 1 2 -2h2c.39 0 .754 .112 1.061 .304",
      "M19 21.5l2.518 -2.58a1.74 1.74 0 0 0 0 -2.413a1.627 1.627 0 0 0 -2.346 0l-.168 .172l-.168 -.172a1.627 1.627 0 0 0 -2.346 0a1.74 1.74 0 0 0 0 2.412l2.51 2.59z",
    ],
  },
  {
    slug: "laboral",
    title: "Laboral",
    summary: "Despidos e indemnizaciones",
    icon: [
      "M3 9a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z",
      "M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2",
      "M12 12l0 .01",
      "M3 13a20 20 0 0 0 18 0",
    ],
  },
  {
    slug: "danos",
    title: "Daños",
    summary: "Accidentes y seguros",
    icon: [
      "M8 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0",
      "M7 6l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-5m0 -6h8m-6 0v-5m2 0h-4",
      "M14 8v-2",
      "M19 12h2",
      "M17.5 15.5l1.5 1.5",
      "M17.5 8.5l1.5 -1.5",
    ],
  },
  {
    slug: "civil",
    title: "Civil y otros",
    summary: "Contratos y deudas",
    icon: [
      "M14 3v4a1 1 0 0 0 1 1h4",
      "M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z",
      "M9 9l1 0",
      "M9 13l6 0",
      "M9 17l6 0",
    ],
  },
];

const steps = [
  "Contanos tu situación",
  "Recibí un rango",
  "Elegí día y hora",
  "Definí cómo avanzar",
];
---

<BaseLayout
  title="SV | Estudio Jurídico — Santa Fe"
  description="Asesoramiento jurídico en sucesiones, laboral, daños y civil en Santa Fe. Cotizá tu caso y reservá una consulta online."
>
  <section class="container hero">
    <p class="label">Asesoramiento · Estrategia · Gestión</p>
    <h1>
      Soluciones jurídicas claras.
      <br />
      Un camino concreto para avanzar.
    </h1>
    <p class="hero-subtitle">
      Te asesoramos, definimos la estrategia y gestionamos tu caso, con precios
      a la vista.
    </p>
    <div class="hero-actions">
      <Button href="/cotizar">Cotizar mi caso</Button>
      <Button variant="ghost" href={calUrl("consulta-inicial")}>
        Reservar una consulta
      </Button>
      <Button variant="ghost" href="/expediente">
        Ya tengo un expediente
      </Button>
    </div>
  </section>

  <section id="servicios" class="container section">
    <div class="section-head">
      <h2>Servicios</h2>
      <p>
        Elegí el área de tu consulta y mirá qué resolvemos, qué incluye y cómo
        se cobra.
      </p>
    </div>
    <ul class="grid areas">
      {areas.map((area) => (
        <li>
          <a class="area-link" href={`/servicios/${area.slug}`}>
            <Card>
              <span class="icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {area.icon.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
              <h3>
                {area.title}{" "}
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </h3>
              <p>{area.summary}</p>
            </Card>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Band variant="beige" id="como-trabajamos">
    <div class="section-head">
      <h2>Cómo trabajamos</h2>
      <p>De tu primera consulta a un plan concreto, en cuatro pasos.</p>
    </div>
    <ol class="grid steps">
      {steps.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  </Band>

  <Band variant="dark">
    <div class="case-file">
      <h2>¿Ya tenés un expediente en curso?</h2>
      <p>
        Podemos ayudarte a comprender el estado de tu proceso, revisar
        documentación y evaluar los pasos que podrían corresponder.
      </p>
      <Button variant="beige" href="/expediente">
        Pedir revisión <span aria-hidden="true">→</span>
      </Button>
    </div>
  </Band>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(64px, 14vw, 180px);
    text-align: center;
    animation: fade-in 400ms var(--ease-out) both;
  }

  .hero h1 {
    margin: 16px 0 20px;
    /* cord sets 100px, but our two-line headline is longer: 72px is the most that fits in two lines. */
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
  }

  .hero-subtitle {
    max-width: 560px;
    margin: 0 auto 32px;
    font-size: 18px;
    color: var(--color-text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .section-head {
    max-width: 720px;
    margin: 0 auto 40px;
    text-align: center;
  }

  h2 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
  }

  .section-head p {
    margin: 12px 0 0;
    font-size: 18px;
    color: var(--color-text-secondary);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .areas li {
    animation: fade-in 400ms var(--ease-out) both;
  }

  .areas li:nth-child(2) {
    animation-delay: 0.08s;
  }

  .areas li:nth-child(3) {
    animation-delay: 0.16s;
  }

  .areas li:nth-child(4) {
    animation-delay: 0.24s;
  }

  .area-link {
    display: block;
    height: 100%;
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }

  .area-link > :global(.card) {
    height: 100%;
    padding: 24px;
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform 160ms var(--ease-out);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-option);
    background: var(--color-selected);
    color: var(--color-primary);
  }

  .icon svg {
    width: 24px;
    height: 24px;
  }

  .area-link h3 {
    margin-top: 20px;
    font-size: 18px;
  }

  .arrow {
    display: inline-block;
    color: var(--color-primary);
    transition: transform 200ms var(--ease-out);
  }

  /* :active is the tap feedback (the tap highlight is off); :hover only for real pointers. */
  .area-link:active > :global(.card) {
    border-color: var(--color-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .area-link:hover > :global(.card) {
      border-color: var(--color-primary);
      box-shadow: var(--shadow-card), var(--shadow-hover);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .area-link:active > :global(.card) {
      transform: scale(0.98);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .area-link:hover .arrow {
      transform: translateX(4px);
    }
  }

  .area-link p {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .steps li {
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    font-size: 18px;
    font-weight: 600;
  }

  .steps li::before {
    content: counter(list-item);
    display: block;
    margin-bottom: 12px;
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary);
  }

  .case-file {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }

  .case-file p {
    margin: 16px 0 28px;
    font-size: 18px;
    color: var(--color-border);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Reduced motion keeps the fade, drops the movement. */
  @media (prefers-reduced-motion: reduce) {
    @keyframes fade-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
