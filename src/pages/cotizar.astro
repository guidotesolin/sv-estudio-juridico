---
import Button from "../components/Button.astro";
import QuoteQuestion from "../components/QuoteQuestion.astro";
import { areas, CONSULTATION_FEE_JUS } from "../data/prices";
import { whatsappUrl } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { calUrl } from "../lib/booking";
import { areaQuestions, complexities, feeText, stages } from "../lib/quote";

const toOptions = (list: readonly { id: string; label: string }[]) =>
  list.map((item) => ({ value: item.id, label: item.label }));

// Area answers use the option index as value; the island maps it back to the label.
const indexOptions = (labels: readonly string[]) =>
  labels.map((label, i) => ({ value: String(i), label }));

const consultationFee = feeText(CONSULTATION_FEE_JUS);
---

<BaseLayout
  title="Cotizá tu caso — SV | Estudio Jurídico"
  description="Respondé unas preguntas y recibí un rango de honorarios orientativo para tu caso."
>
  <section class="container quote">
    <h1>Cotizá tu caso</h1>
    <p class="lead">
      Cuatro pasos, sin datos personales. Al final ves un rango de honorarios
      orientativo.
    </p>

    <noscript>
      <p class="warning">
        El cotizador necesita JavaScript. Podés escribirnos por
        <a href={whatsappUrl}>WhatsApp</a> o
        <a href={calUrl("consulta-inicial")}>reservar una consulta</a>.
      </p>
    </noscript>

    <!-- Hidden until the island runs: without it, Siguiente would do a native GET to this page. -->
    <form id="quote" novalidate hidden>
      <section data-step>
        <h2 tabindex="-1">Paso 1 de 4 · Área</h2>
        <QuoteQuestion
          legend="¿Sobre qué es tu consulta?"
          name="area"
          options={toOptions(areas)}
        />
        <div class="step-nav">
          <Button type="submit">Siguiente</Button>
        </div>
      </section>

      <section data-step hidden>
        <h2 tabindex="-1">Paso 2 de 4 · Servicio</h2>
        {areas.map((area) => (
          <div data-area={area.id} hidden>
            <QuoteQuestion
              legend="¿Qué necesitás?"
              name={`service-${area.id}`}
              options={toOptions(area.services)}
            />
          </div>
        ))}
        <div class="step-nav">
          <Button variant="ghost" data-back>
            Atrás
          </Button>
          <Button type="submit">Siguiente</Button>
        </div>
      </section>

      <section data-step hidden>
        <h2 tabindex="-1">Paso 3 de 4 · Preguntas del área</h2>
        <p class="hint">
          No cambian el precio: nos ayudan a preparar la consulta.
        </p>
        {areas.map((area) => (
          <div class="questions" data-area={area.id} hidden>
            {areaQuestions[area.id].map((q, i) => (
              <QuoteQuestion
                legend={q.question}
                name={`q-${area.id}-${i}`}
                options={indexOptions(q.options)}
                multiple={q.multiple}
              />
            ))}
          </div>
        ))}
        <div class="step-nav">
          <Button variant="ghost" data-back>
            Atrás
          </Button>
          <Button type="submit">Siguiente</Button>
        </div>
      </section>

      <section data-step hidden>
        <h2 tabindex="-1">Paso 4 de 4 · Situación</h2>
        <div class="questions">
          <QuoteQuestion
            legend="¿En qué etapa está?"
            name="stage"
            options={toOptions(stages)}
          />
          <QuoteQuestion
            legend="¿Cómo describirías el caso?"
            name="complexity"
            options={toOptions(complexities)}
          />
          <QuoteQuestion
            legend="¿Tenés un plazo próximo?"
            name="deadline"
            options={[
              { value: "no", label: "No" },
              {
                value: "yes",
                label: "Sí, tengo una audiencia, notificación o vencimiento",
              },
            ]}
          />
        </div>
        <div class="step-nav">
          <Button variant="ghost" data-back>
            Atrás
          </Button>
          <Button type="submit">Ver estimación</Button>
        </div>
      </section>
    </form>

    <section id="quote-result" hidden>
      <div id="deadline-warning" class="warning" hidden>
        <p id="deadline-text" tabindex="-1">
          Si tenés un plazo corriendo, escribinos ya por WhatsApp para
          verificarlo.
        </p>
        <Button href={whatsappUrl}>Escribir por WhatsApp</Button>
      </div>

      <div class="result">
        <h2 tabindex="-1">Tu estimación</h2>
        <p id="result-service" class="label"></p>
        <p id="result-amount" class="amount"></p>
        <p id="result-jus" class="jus"></p>
        <p>Pagable en cuotas.</p>

        <div class="lists">
          <div>
            <h3>Incluye</h3>
            <ul id="result-includes"></ul>
          </div>
          <div>
            <h3>No incluye</h3>
            <ul id="result-excludes"></ul>
          </div>
        </div>

        <p>Tasas, aportes y gastos aparte.</p>
        <p>
          La consulta se abona y se descuenta del total si iniciás el trabajo
          con el estudio. Valor de la consulta: {consultationFee}.
        </p>
        <p class="disclaimer">
          Esta estimación es orientativa. No crea una relación profesional ni
          implica la aceptación del caso. Los honorarios no incluyen tasas,
          aportes ni gastos.
        </p>

        <div class="step-nav">
          <Button variant="ghost" data-back>
            Cambiar respuestas
          </Button>
          <Button id="result-booking" href={calUrl("consulta-inicial")}>
            Reservar consulta
          </Button>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<script>
  import { areas } from "../data/prices";
  import { quoteBookingUrl } from "../lib/booking";
  import {
    areaQuestions,
    complexities,
    estimate,
    estimateText,
    isAreaId,
    stages,
    type AreaAnswer,
    type QuoteAnswers,
  } from "../lib/quote";

  // Nothing is stored and nothing is sent: answers live in the form until the page closes.
  function required<T>(el: T | null | undefined): T {
    if (!el) throw new Error("Quote markup missing");

    return el;
  }

  const form = required(document.querySelector<HTMLFormElement>("#quote"));
  const result = required(document.querySelector<HTMLElement>("#quote-result"));
  const steps = [...form.querySelectorAll<HTMLElement>("[data-step]"), result];
  let current = 0;

  const byId = (id: string) => required(document.getElementById(id));

  function checkedValue(name: string): string | undefined {
    return form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)
      ?.value;
  }

  function selectedArea() {
    const id = checkedValue("area");

    return id && isAreaId(id) ? id : undefined;
  }

  // DOM values are validated against the data, never cast: estimate throws on unknown ids.
  function readAnswers(): QuoteAnswers | undefined {
    const area = selectedArea();

    if (!area) return;

    const service = checkedValue(`service-${area}`);
    const stage = stages.find((s) => s.id === checkedValue("stage"));

    const complexity = complexities.find(
      (c) => c.id === checkedValue("complexity"),
    );

    const deadline = checkedValue("deadline");

    const knownService = areas
      .find((a) => a.id === area)
      ?.services.some((s) => s.id === service);

    if (!service || !knownService || !stage || !complexity || !deadline) {
      return;
    }

    const areaAnswers: AreaAnswer[] = [];

    areaQuestions[area].forEach((q, i) => {
      const labels: string[] = [];

      for (const input of form.querySelectorAll<HTMLInputElement>(
        `input[name="q-${area}-${i}"]:checked`,
      )) {
        const label = q.options[Number(input.value)];

        if (label) labels.push(label);
      }

      areaAnswers.push({ question: q.question, answer: labels.join(", ") });
    });

    return {
      area,
      service,
      stage: stage.id,
      complexity: complexity.id,
      deadline: deadline === "yes",
      areaAnswers,
    };
  }

  // Every visible question needs an answer; focus goes to the first one missing.
  function validate(step: HTMLElement): boolean {
    let firstMissing: HTMLInputElement | undefined;

    for (const q of step.querySelectorAll("fieldset.question")) {
      const error = required(q.querySelector(".error"));

      const answered =
        q.closest("[hidden]") !== null || q.querySelector(":checked") !== null;

      error.textContent = answered ? "" : "Elegí una opción para seguir.";

      if (!answered) {
        firstMissing ??= required(q.querySelector<HTMLInputElement>("input"));
      }
    }

    firstMissing?.focus();

    return !firstMissing;
  }

  // Focus goes to the step's heading, or to `focus` when something must be read first.
  function show(index: number, focus?: HTMLElement) {
    const area = selectedArea();

    for (const el of form.querySelectorAll<HTMLElement>("[data-area]")) {
      el.hidden = el.dataset.area !== area;
    }

    steps.forEach((step, i) => {
      step.hidden = i !== index;
    });

    current = index;
    (focus ?? required(steps[index]?.querySelector<HTMLElement>("h2"))).focus();
  }

  function fillList(id: string, items: readonly string[]) {
    byId(id).replaceChildren(
      ...items.map((item) => {
        const li = document.createElement("li");

        li.textContent = item;

        return li;
      }),
    );
  }

  // Estimate comes from the answers just read, so going back and changing anything recomputes it.
  function showResult(answers: QuoteAnswers) {
    const e = estimate(answers);
    const area = required(areas.find((a) => a.id === answers.area));

    const service = required(
      area.services.find((s) => s.id === answers.service),
    );

    const { amount, jus } = estimateText(e);
    const jusEl = byId("result-jus");

    byId("deadline-warning").hidden = !answers.deadline;
    byId("result-service").textContent = `${area.label} · ${service.label}`;
    byId("result-amount").textContent = amount;
    jusEl.textContent = jus;
    jusEl.hidden = !jus;
    fillList("result-includes", e.includes);
    fillList("result-excludes", e.excludes);

    byId("result-booking").setAttribute("href", quoteBookingUrl(answers, e));

    // An urgent deadline leads the result, so it's what keyboard and screen readers reach first.
    show(
      steps.length - 1,
      answers.deadline ? byId("deadline-text") : undefined,
    );
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!validate(required(steps[current]))) return;

    if (current < steps.length - 2) return show(current + 1);

    const answers = readAnswers();

    // Only reachable with values that aren't in the data (e.g. an edited DOM): start over.
    if (!answers) return show(0);

    showResult(answers);
  });

  // Picking an answer clears that question's error.
  form.addEventListener("change", (event) => {
    if (!(event.target instanceof Element)) return;

    const error = event.target.closest(".question")?.querySelector(".error");

    if (error) error.textContent = "";
  });

  for (const back of document.querySelectorAll("[data-back]")) {
    back.addEventListener("click", () => show(current - 1));
  }

  form.hidden = false;

  // `?area=` preselects step 1; an unknown value is ignored.
  const areaParam = new URLSearchParams(location.search).get("area");

  if (areaParam && isAreaId(areaParam)) {
    const input = form.querySelector<HTMLInputElement>(
      `input[name="area"][value="${areaParam}"]`,
    );

    if (input) input.checked = true;
  }
</script>

<style>
  .quote {
    max-width: 720px;
    padding-block: clamp(48px, 8vw, 96px) 0;
  }

  h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
  }

  .lead {
    margin-bottom: 40px;
  }

  h2 {
    margin-bottom: 24px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hint {
    margin: -12px 0 24px;
    color: var(--color-text-secondary);
  }

  .questions {
    display: grid;
    gap: 32px;
  }

  .step-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 32px;
  }

  .warning {
    margin-bottom: 24px;
    padding: 20px;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .warning p {
    margin: 0 0 16px;
    font-size: 18px;
    font-weight: 700;
  }

  .result {
    padding: clamp(20px, 5vw, 40px);
    border-radius: var(--radius-card);
    background: var(--color-beige);
  }

  .result p {
    margin: 0 0 12px;
  }

  .result h2 {
    margin-bottom: 8px;
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 800;
    letter-spacing: -0.5px;
    text-transform: none;
    color: var(--color-text);
  }

  .amount {
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 800;
    line-height: 1.1;
  }

  .jus {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 20px;
    margin-block: 24px;
  }

  .lists h3 {
    font-size: 18px;
  }

  .lists ul {
    margin: 8px 0 0;
    padding-left: 20px;
    color: var(--color-text-secondary);
  }

  .disclaimer {
    font-size: 14px;
    color: var(--color-text-secondary);
  }
</style>
