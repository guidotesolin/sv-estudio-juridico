---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import Card from "../components/Card.astro";
import QuoteBand from "../components/QuoteBand.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const howWeWork = [
  "Antes de la consulta ves un rango orientativo de honorarios, en JUS y en pesos.",
  "La consulta se abona y se descuenta del total si iniciás el trabajo con el estudio.",
  "El alcance del trabajo se acuerda antes de empezar.",
  "Atención presencial o por videollamada.",
  "Convenios de pago en cuotas.",
];
---

<BaseLayout
  title="Sobre el estudio — SV & ASOC. | Estudio Jurídico"
  description="Quiénes somos y cómo trabajamos: asesoramiento jurídico claro en Santa Fe, presencial o por videollamada."
>
  <section class="container page-hero">
    <h1>
      <span class="label">Sobre el estudio</span> Un estudio cercano, con
      explicaciones claras.
    </h1>
    <p class="lead">
      SV & ASOC. (Sabrina Vidoni y asociados) acompaña a personas y empresas de
      Santa Fe y alrededores en diferentes áreas del derecho: sucesiones,
      laboral, daños y perjuicios, civil y comercial, etc.
    </p>
  </section>

  <div class="container profile">
    <Image
      class="portrait"
      src={portrait}
      alt="Retrato de Sabrina Vidoni en su escritorio"
      widths={[320, 640]}
      sizes="320px"
      loading="eager"
    />
    <Card>
      <h2>Sabrina Vidoni</h2>
      <p class="meta">
        Abogada · Matrícula provincial Tº V Fº 558, Expte. 9552, Colegio de
        Abogados de Santa Fe, 1ª circunscripción · Matrícula federal Tº 406 Fº
        699
      </p>
      <p>
        Derecho público y privado: administrativo, civil, laboral, daños y
        sucesiones.
      </p>
    </Card>
  </div>

  <div class="container page-blocks">
    <Card>
      <h2>Experiencia</h2>
      <ul>
        <li>
          Abogada litigante y asesoramiento en derecho civil, accidentes de
          tránsito, laboral, sucesiones y administrativo.
        </li>
        <li>
          Responsable y apoderada legal en el Servicio Jurídico del 7º Distrito
          Santa Fe de la Dirección Nacional de Vialidad: defensa judicial del
          organismo, dictámenes, licitaciones y ejecución de obras públicas.
        </li>
      </ul>
    </Card>

    <Card>
      <h2>Formación</h2>
      <ul>
        <li>
          Abogada, Facultad de Ciencias Jurídicas y Sociales, Universidad
          Nacional del Litoral.
        </li>
        <li>
          Especialista en Derecho Procesal Penal, Facultad de Ciencias Jurídicas
          y Sociales, Universidad Nacional del Litoral.
        </li>
        <li>
          Abogacía del Estado: Asesoramiento Jurídico, Procuración del Tesoro de
          la Nación.
        </li>
      </ul>
    </Card>

    <Card>
      <h2>Cómo trabajamos</h2>
      <ul>
        {howWeWork.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </Card>
  </div>

  <QuoteBand />
</BaseLayout>

<style>
  .profile {
    display: grid;
    gap: 20px;
    align-items: center;
    margin-bottom: 20px;
  }

  /* The photo is square; 4:5 crops the sides and keeps the face in the upper third. */
  .portrait {
    aspect-ratio: 4 / 5;
    max-width: 320px;
    width: 100%;
    height: auto;
    justify-self: center;
    border-radius: var(--radius-card);
    object-fit: cover;
    object-position: 50% 20%;
    background: var(--color-beige);
  }

  .profile h2 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
  }

  .profile p {
    margin: 12px 0 0;
    color: var(--color-text-secondary);
  }

  .profile .meta {
    margin-top: 8px;
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .profile {
      grid-template-columns: 320px 1fr;
    }
  }
</style>
