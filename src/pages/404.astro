---
import Button from "../components/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { whatsappUrl } from "../data/site";

// Cloudflare Pages serves dist/404.html with a 404 status for any unknown path.
const quickLinks = [
  { href: "/cotizar", label: "Cotizar mi caso" },
  { href: "/#servicios", label: "Servicios" },
  { href: "/preguntas", label: "Preguntas frecuentes" },
  { href: whatsappUrl, label: "Escribinos por WhatsApp" },
];
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscás no existe o cambió de dirección. Volvé al inicio para ver los servicios del estudio."
>
  <section class="container not-found">
    <p class="badge">Error 404</p>
    <h1>No encontramos esta página.</h1>
    <p class="lead">
      Puede que el enlace esté mal escrito o que la página ya no exista. Desde
      el inicio llegás a todo lo que ofrece el estudio.
    </p>
    <Button href="/">
      <span class="home">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V21h14V9.5" />
        </svg>
        Volver al inicio
      </span>
    </Button>

    <nav class="quick" aria-label="Otras páginas">
      <p>O seguí por acá</p>
      <ul>
        {quickLinks.map((link) => (
          <li>
            <a href={link.href}>
              {link.label}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(64px, 10vw, 120px);
    text-align: center;
    animation: fade-in 300ms var(--ease-out) both;
  }

  .badge {
    margin: 0 0 20px;
    padding: 6px 14px;
    border-radius: var(--radius-control);
    background: var(--color-beige);
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 600;
  }

  h1 {
    max-width: 760px;
    /* Same scale as the home hero: this page is a destination of its own, not an inner page. */
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
  }

  .lead {
    max-width: 560px;
    margin: 24px 0 36px;
    font-size: 18px;
    color: var(--color-text-secondary);
  }

  .home {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .home svg {
    width: 18px;
    height: 18px;
  }

  .quick {
    width: 100%;
    max-width: 880px;
    margin-top: 64px;
  }

  .quick p {
    margin: 0 0 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .quick ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quick a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    box-sizing: border-box;
    /* Fill the grid row, so a label that wraps doesn't leave its neighbors shorter. */
    height: 100%;
    min-height: 56px;
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    font-weight: 600;
    text-align: left;
    text-decoration: none;
    transition:
      border-color var(--transition),
      transform 160ms var(--ease-out);
  }

  .arrow {
    color: var(--color-primary);
    transition: transform 200ms var(--ease-out);
  }

  /* :active is the tap feedback (the tap highlight is off); :hover only for real pointers. */
  .quick a:active {
    border-color: var(--color-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .quick a:hover {
      border-color: var(--color-primary);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .quick a:active {
      transform: scale(0.98);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .quick a:hover .arrow {
      transform: translateX(4px);
    }
  }
</style>
