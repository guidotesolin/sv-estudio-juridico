---
import { getCollection, type CollectionEntry } from "astro:content";
import Band from "../../components/Band.astro";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import { areas } from "../../data/prices";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("services");

  return entries.map((entry) => ({
    params: { area: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"services">;
}

const { entry } = Astro.props;

const { title, headline, summary, notice, documentation, notIncluded } =
  entry.data;

const services = areas.find((a) => a.id === entry.id)?.services;

if (!services) {
  throw new Error(`No services listed for area "${entry.id}"`);
}
---

<BaseLayout title={`${title} — SV | Estudio Jurídico`} description={summary}>
  <section class="container page-hero">
    <h1>
      <span class="label">{title}</span> {headline}
    </h1>
  </section>

  <div class="container page-blocks">
    <Card>
      <h2>Qué resolvemos</h2>
      <p>{summary}</p>
      {notice && <p class="notice">{notice}</p>}
    </Card>

    <Card>
      <h2>Qué incluye</h2>
      <ul>
        {services.map((service) => (
          <li>{service.label}</li>
        ))}
      </ul>
    </Card>

    <Card>
      <h2>Documentación para la consulta</h2>
      <ul>
        {documentation.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </Card>

    <Card>
      <h2>Cómo se cobra</h2>
      <p>
        Honorarios según ley arancelaria, expresados en JUS. Pagable en cuotas.
      </p>
    </Card>

    <Card>
      <h2>Qué no incluye</h2>
      <ul>
        {notIncluded.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </Card>
  </div>

  <Band variant="dark">
    <h2>¿Cuánto cuesta tu caso?</h2>
    <p>Respondé unas preguntas y recibí un rango de honorarios orientativo.</p>
    <Button variant="beige" href={`/cotizar?area=${entry.id}`}>
      Cotizá tu caso <span aria-hidden="true">→</span>
    </Button>
  </Band>
</BaseLayout>
