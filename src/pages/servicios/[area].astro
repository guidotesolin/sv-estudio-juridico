---
import { getCollection, type CollectionEntry } from "astro:content";
import Band from "../../components/Band.astro";
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
import { areas } from "../../data/prices";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("services");

  return entries.map((entry) => ({
    params: { area: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"services">;
}

const { entry } = Astro.props;

const { title, headline, summary, notice, documentation, notIncluded } =
  entry.data;

const services = areas.find((a) => a.id === entry.id)?.services;

if (!services) {
  throw new Error(`No services listed for area "${entry.id}"`);
}
---

<BaseLayout title={`${title} — SV | Estudio Jurídico`} description={summary}>
  <section class="container hero">
    <h1>
      <span class="label">{title}</span> {headline}
    </h1>
  </section>

  <div class="container blocks">
    <Card>
      <h2>Qué resolvemos</h2>
      <p>{summary}</p>
      {notice && <p class="notice">{notice}</p>}
    </Card>

    <Card>
      <h2>Qué incluye</h2>
      <ul>
        {services.map((service) => (
          <li>{service.label}</li>
        ))}
      </ul>
    </Card>

    <Card>
      <h2>Documentación para la consulta</h2>
      <ul>
        {documentation.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </Card>

    <Card>
      <h2>Cómo se cobra</h2>
      <p>
        Honorarios según ley arancelaria, expresados en JUS. Pagable en cuotas.
      </p>
    </Card>

    <Card>
      <h2>Qué no incluye</h2>
      <ul>
        {notIncluded.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </Card>
  </div>

  <Band variant="dark">
    <h2>¿Cuánto cuesta tu caso?</h2>
    <p>Respondé unas preguntas y recibí un rango de honorarios orientativo.</p>
    <Button variant="beige" href={`/cotizar?area=${entry.id}`}>
      Cotizá tu caso <span aria-hidden="true">→</span>
    </Button>
  </Band>
</BaseLayout>

<style>
  .hero {
    max-width: 880px;
    padding-block: clamp(48px, 8vw, 96px) 40px;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
  }

  /* The area name lives inside the h1 so headings and search engines get it; styled as the label. */
  .hero .label {
    display: block;
    margin-bottom: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  .blocks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 20px;
  }

  .blocks h2 {
    font-size: 20px;
    font-weight: 700;
  }

  .blocks p,
  .blocks ul {
    margin: 12px 0 0;
    color: var(--color-text-secondary);
  }

  .blocks ul {
    padding-left: 20px;
  }

  .blocks li + li {
    margin-top: 6px;
  }

  .blocks .notice {
    padding: 12px 16px;
    border-radius: var(--radius-option);
    background: var(--color-beige);
    color: var(--color-text);
    font-weight: 600;
  }
</style>
