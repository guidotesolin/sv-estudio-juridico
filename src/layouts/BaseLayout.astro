---
import { getCollection } from "astro:content";
import "../styles/global.css";
import Button from "../components/Button.astro";
import { email, whatsappUrl } from "../data/site";
import { calUrl } from "../lib/booking";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const bookingUrl = calUrl("consulta-inicial");

// Same source and order as the home's area cards, so the footer and the cards can't drift apart.
const services = (await getCollection("services")).toSorted(
  (a, b) => a.data.order - b.data.order,
);

const navLinks = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#como-trabajamos", label: "Cómo trabajamos" },
  { href: "/estudio", label: "Sobre el estudio" },
  { href: "/preguntas", label: "Preguntas" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf8f2" />
    <!-- PNG first for browsers without SVG favicons; the rest take the SVG. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Saltar al contenido
    </a>
    <header class="site-header">
      <div class="container header-row">
        <a class="wordmark" href="/">
          SV &amp; ASOC. <span>| Estudio Jurídico</span>
        </a>

        <nav class="nav-desktop" aria-label="Principal">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <Button href={bookingUrl}>Reservar consulta</Button>
        </nav>

        <details class="nav-mobile">
          <summary>Menú</summary>
          <nav class="container" aria-label="Principal">
            {navLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
            <Button href={bookingUrl}>Reservar consulta</Button>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-columns">
          <div>
            <a class="wordmark" href="/">
              SV &amp; ASOC. <span>| Estudio Jurídico</span>
            </a>
            <p>
              Asesoramiento jurídico en Santa Fe, presencial o por videollamada.
            </p>
          </div>

          <div>
            <h2>Servicios</h2>
            <ul>
              {services.map((service) => (
                <li>
                  <a href={`/servicios/${service.id}`}>{service.data.title}</a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2>Estudio</h2>
            <ul>
              <li>
                <a href="/estudio">Sobre el estudio</a>
              </li>
              <li>
                <a href="/preguntas">Preguntas frecuentes</a>
              </li>
              <li>
                <a href="/expediente">Expediente en curso</a>
              </li>
            </ul>
          </div>

          <div>
            <h2>Contacto</h2>
            <ul>
              <li>
                <a href={whatsappUrl}>WhatsApp</a>
              </li>
              <li>
                <a href={`mailto:${email}`}>{email}</a>
              </li>
              <li>Atención presencial y remota · Santa Fe</li>
            </ul>
          </div>
        </div>

        <div class="footer-legal">
          <p>
            Este sitio no almacena datos personales. Los datos de reserva los
            gestionan Cal.com y Google Calendar, y el cotizador no pide
            información sensible (Ley 25.326).
          </p>
          <p>
            La información de este sitio es orientativa. No crea una relación
            profesional ni implica la aceptación del caso.
          </p>
        </div>

        <a
          class="footer-credit"
          href="https://pipacode.studio/?utm_source=sv-estudio-juridico&utm_medium=footer"
        >
          Desarrollado por
          <svg
            width="20"
            height="17"
            viewBox="0 0 64 56"
            fill="none"
            stroke="currentColor"
            stroke-width="7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <g transform="translate(0,6)">
              <path d="M6 36 C16 36 23 42 33 42"></path>
              <path d="M31 26 H57"></path>
              <path d="M34 26 V38 A10 10 0 0 0 54 38 V26"></path>
              <path d="M45 19 L38.5 12.5 L45 6" stroke-width="6"></path>
            </g>
          </svg>
          <strong>Pipa Code</strong>
        </a>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    z-index: 2;
    padding: 8px 16px;
    background: var(--color-card);
    border-radius: var(--radius-control);
  }

  .skip-link:focus {
    top: 8px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-border);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }

  .wordmark {
    color: var(--color-text);
    font-size: 17px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--transition);
  }

  .wordmark:active {
    opacity: 0.7;
  }

  .wordmark span {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  nav a:not(.button) {
    color: var(--color-text-secondary);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition);
  }

  /* :active is the tap feedback (the tap highlight is off); :hover only for real pointers. */
  nav a:not(.button):active {
    color: var(--color-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:not(.button):hover {
      color: var(--color-primary);
    }
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 24px;
    font-size: 14px;
  }

  .nav-mobile summary {
    list-style: none;
    padding: 8px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-card);
    color: var(--color-primary);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--transition);
  }

  .nav-mobile summary:active,
  .nav-mobile[open] summary {
    background: var(--color-selected);
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    justify-items: start;
    gap: 16px;
    padding-block: 16px 24px;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 900px) {
    .nav-desktop {
      display: flex;
    }

    .nav-mobile {
      display: none;
    }
  }

  /* Column footer as on cord.com: wordmark + description, then link columns; legal notes below. */
  .site-footer {
    margin-top: var(--section-gap);
    padding-block: 48px 32px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 14px;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 32px 24px;
  }

  .footer-columns p {
    max-width: 280px;
    margin: 12px 0 0;
  }

  .footer-columns h2 {
    margin-bottom: 12px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .footer-columns ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-columns ul a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--transition);
  }

  .footer-columns ul a:active {
    color: var(--color-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-columns ul a:hover {
      color: var(--color-primary);
    }
  }

  .footer-legal {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .footer-legal p {
    margin: 0 0 12px;
  }

  .footer-credit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 4px;
    color: inherit;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-credit strong {
    color: var(--color-text);
  }

  .footer-credit:active {
    color: var(--color-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-credit:hover {
      color: var(--color-primary);
    }
  }
</style>
