---
import "../styles/global.css";
import Button from "../components/Button.astro";
import { email, whatsappUrl } from "../data/site";
import { calUrl } from "../lib/booking";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const bookingUrl = calUrl("consulta-inicial");

const navLinks = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#como-trabajamos", label: "Cómo trabajamos" },
  { href: "/estudio", label: "Sobre el estudio" },
  { href: "/preguntas", label: "Preguntas" },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf8f2" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Saltar al contenido
    </a>
    <header class="site-header">
      <div class="container header-row">
        <a class="wordmark" href="/">
          SV <span>| Estudio Jurídico</span>
        </a>

        <nav class="nav-desktop" aria-label="Principal">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <Button href={bookingUrl}>Reservar consulta</Button>
        </nav>

        <details class="nav-mobile">
          <summary>Menú</summary>
          <nav class="container" aria-label="Principal">
            {navLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
            <Button href={bookingUrl}>Reservar consulta</Button>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="footer-contact">
          <a href={whatsappUrl}>WhatsApp</a>
          <a href={`mailto:${email}`}>{email}</a>
          <span>Atención presencial y remota · Santa Fe</span>
        </p>
        <p>
          Este sitio no almacena datos personales. Los datos de reserva los
          gestionan Cal.com y Google Calendar, y el cotizador no pide
          información sensible (Ley 25.326).
        </p>
        <p>
          La información de este sitio es orientativa. No crea una relación
          profesional ni implica la aceptación del caso.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    z-index: 2;
    padding: 8px 16px;
    background: var(--color-card);
    border-radius: var(--radius-control);
  }

  .skip-link:focus {
    top: 8px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-border);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }

  .wordmark {
    color: var(--color-text);
    font-size: 17px;
    font-weight: 800;
    text-decoration: none;
  }

  .wordmark span {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  nav a:not(.button) {
    color: var(--color-text-secondary);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition);
  }

  /* :active is the tap feedback (the tap highlight is off); :hover only for real pointers. */
  nav a:not(.button):active {
    color: var(--color-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:not(.button):hover {
      color: var(--color-primary);
    }
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 24px;
    font-size: 14px;
  }

  .nav-mobile summary {
    list-style: none;
    padding: 8px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-card);
    color: var(--color-primary);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--transition);
  }

  .nav-mobile summary:active,
  .nav-mobile[open] summary {
    background: var(--color-selected);
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    justify-items: start;
    gap: 16px;
    padding-block: 16px 24px;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 900px) {
    .nav-desktop {
      display: flex;
    }

    .nav-mobile {
      display: none;
    }
  }

  .site-footer {
    margin-top: var(--section-gap);
    padding-block: 32px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 14px;
  }

  .site-footer p {
    margin: 0 0 12px;
    max-width: 720px;
  }

  .footer-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
</style>
